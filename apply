#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: $0 <satellite_root_dir>, exit 1"
    exit 1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
FILE="$SCRIPT_DIR/config.yaml"

if [[ ! -f "$FILE" ]]; then
    echo "Error: File '$FILE' does not exist. exit 2"
    exit 2
fi

DIR="$1"

apply_rule() {
    local rule="$1"
    local file="$2"
    local expected="$3"

    local count
    count=$(
        ast-grep scan \
            --rule "$rule" \
            --json=compact \
            "$file" |
        jq length
    )

    if [[ "$count" -ne "$expected" ]]; then
        echo "ERROR: Expected $expected match(es) for $rule in $file, found $count." >&2
        exit 1
    fi

    ast-grep scan \
        --rule "$rule" \
        --update-all \
        "$file"
}

apply_rule patches/1783440418_remove_stripe_client.yml "$DIR/satellite/payments/stripe/mud.go" 1
apply_rule patches/1783432229_optional_stripe.yml "$DIR/satellite/mud.go" 1

BRANDING_NAME=$(yq '.["console.single-white-label"].name' config.yaml)

env BRANDING_NAME="$BRANDING_NAME" envsubst '${BRANDING_NAME}' \
    < patches/1783446586_hijack_default_branding_name.yml.template \
    > /tmp/branding-rule.yml

apply_rule /tmp/branding-rule.yml "$DIR" 2
