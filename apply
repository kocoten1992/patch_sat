#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: $0 <satellite_root_dir>, exit 1"
    exit 1
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
FILE="$SCRIPT_DIR/config.yaml"

if [[ ! -f "$FILE" ]]; then
    echo "Error: File '$FILE' does not exist. exit 2"
    exit 2
fi

DIR="$1"

apply_rule() {
    local rule="$1"
    local file="$2"
    local expected="$3"

    local count

    count=$(ast-grep scan --rule "$rule" --json=compact "$file" | jq length)

    if [[ "$count" -ne "$expected" ]]; then
        echo "ERROR: Expected $expected match(es) for $rule in $file, found $count." >&2
        exit 1
    fi

    ast-grep scan \
        --rule "$rule" \
        --update-all \
        "$file"
}

apply_comby_rule() {
    local rule_dir="$1"
    local file="$2"
    local expected="$3"

    local match rewrite matcher count
    match="$(cat "$rule_dir/match")"
    rewrite="$(cat "$rule_dir/rewrite")"
    matcher="$(cat "$rule_dir/matcher" 2>/dev/null || echo ".generic")"

    count=$(comby "$match" "" -matcher "$matcher" -json-lines "$file" | jq -s length)

    if [[ "$count" -ne "$expected" ]]; then
        echo "ERROR: Expected $expected match(es) for $rule_dir in $file, found $count." >&2
        exit 1
    fi

    comby "$match" "$rewrite" -matcher "$matcher" -in-place "$file"
}

# git revert
commits=(
    # ci: remove CockroachDB and Spanner integration tests
    "40bb0c87b84fa05013136699fd4043af5f2283d1"
)

for commit in "${commits[@]}"; do
    if git -C $DIR merge-base --is-ancestor "$commit" HEAD; then
        git -C $DIR revert --no-edit "$commit"
    fi
done

# patch
apply_rule "$SCRIPT_DIR/patches/1783440418_remove_stripe_client.yml" "$DIR/satellite/payments/stripe/mud.go" 1
apply_rule "$SCRIPT_DIR/patches/1783432229_optional_stripe.yml" "$DIR/satellite/mud.go" 1

BRANDING_NAME=$(yq '.["console.single-white-label"].name' "$SCRIPT_DIR/config.yaml")

env BRANDING_NAME="$BRANDING_NAME" envsubst '${BRANDING_NAME}' \
    < "$SCRIPT_DIR/patches/1783446586_hijack_default_branding_name.yml.template" \
    > /tmp/branding-rule.yml

apply_rule /tmp/branding-rule.yml "$DIR" 2
apply_rule "$SCRIPT_DIR/patches/1784299063_crdb_use_skip_locked.yml" "$DIR/satellite/satellitedb/verifyqueue.go" 1
apply_rule "$SCRIPT_DIR/patches/1784363774_update_crdb_image_latest.yml" "$DIR/testsuite" 1
apply_rule "$SCRIPT_DIR/patches/1784396915_merge_bucket_bandwidth_rollups_pk.yml" "$DIR/satellite/satellitedb/migrate.go" 1
apply_rule "$SCRIPT_DIR/patches/1784399045_merge_bucket_bandwidth_metainfos_pk.yml" "$DIR/satellite/satellitedb/migrate.go" 1
apply_comby_rule "$SCRIPT_DIR/patches/1784665055_disable_stripe_frontend_setup" "$DIR/web/satellite/src/App.vue" 1
