+}
+
+// modularReadNowConfig disables the "AS OF SYSTEM TIME" staleness of the modular satellite (CockroachDB reads data
+// as of some time in the past). The classic sim ran with --defaults dev, which makes all of them (almost) zero, but
+// the modular satellite has no dev defaults and uses the release ones (-5m for tally, zombie deletion, ranged loop,
+// -10s for the node cache). A database that was created less than that ago does not exist yet as of that time, so
+// CockroachDB answers `database "..." does not exist (SQLSTATE 3D000)`, and freshly checked-in nodes are invisible.
+// These values are the dev defaults of the classic satellite (0 where there is no dev default).
+var modularReadNowConfig = map[string]string{
+	"tally.as-of-system-interval":                     "-1us",
+	"zombie-deletion.as-of-system-interval":           "-1us",
+	"ranged-loop.as-of-system-interval":               "-1us",
+	"expired-deletion.as-of-system-interval":          "-1us",
+	"live-accounting.as-of-system-interval":           "-1us",
+	"console-db-cleanup.as-of-system-time-interval":   "0",
+	"overlay.as-of-system-time":                       "0",
+	"overlay.node.as-of-system-time.default-interval": "-1ms",
+}
+
+// overrideModularConfig sets the keys of overrides in an existing config.yaml, replacing a value that is already
+// there (ensureModularConfig keeps existing values, but the config.yaml of `satellite setup` of a previous release
+// may hold the release defaults). Comments and other keys are kept as they are.
+func overrideModularConfig(dir string, overrides map[string]string) error {
+	path := filepath.Join(dir, "config.yaml")
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return errs.Wrap(err)
+	}
+
+	var content strings.Builder
+	for _, line := range strings.Split(strings.TrimRight(string(data), "\n"), "\n") {
+		key, _, _ := strings.Cut(line, ":")
+		if _, ok := overrides[strings.TrimSpace(key)]; ok {
+			continue
+		}
+		content.WriteString(line)
+		content.WriteString("\n")
+	}
+	for _, key := range sortedKeys(overrides) {
+		line, err := yamlLine(key, overrides[key])
+		if err != nil {
+			return err
+		}
+		content.WriteString(line)
+	}
+	if content.String() == string(data) {
+		return nil
+	}
+
+	// the other satellite processes read this file while they start up, replace it atomically
+	// (a truncated file would be read as an empty configuration)
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, []byte(content.String()), 0644); err != nil {
+		return errs.Wrap(err)
+	}
+	return errs.Wrap(os.Rename(tmp, path))
 }
 
