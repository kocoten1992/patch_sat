+func TestOverrideModularConfig(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "config.yaml")
+
+	// a config.yaml created by `satellite setup` of a previous release, with a release default
+	classic := "# tally.as-of-system-interval: -5m0s\nserver.address: 127.0.0.1:10000\nranged-loop.as-of-system-interval: -5m0s\n"
+	require.NoError(t, os.WriteFile(path, []byte(classic), 0644))
+
+	require.NoError(t, overrideModularConfig(dir, modularReadNowConfig))
+
+	content, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.Contains(t, string(content), "# tally.as-of-system-interval: -5m0s\n", "comments must be kept")
+
+	var value string
+	require.NoError(t, readConfigString(&value, dir, "ranged-loop.as-of-system-interval"))
+	require.Equal(t, "-1us", value, "the existing value must be replaced")
+	require.NoError(t, readConfigString(&value, dir, "tally.as-of-system-interval"))
+	require.Equal(t, "-1us", value)
+	require.NoError(t, readConfigString(&value, dir, "server.address"))
+	require.Equal(t, "127.0.0.1:10000", value, "other keys must be kept")
+	// replaced, not duplicated (viper would fail on duplicate keys)
+	require.Equal(t, 1, countLines(t, content, "ranged-loop.as-of-system-interval:"))
+
+	// idempotent
+	require.NoError(t, overrideModularConfig(dir, modularReadNowConfig))
+	again, err := os.ReadFile(path)
+	require.NoError(t, err)
+	require.Equal(t, string(content), string(again))
+
+	// a config written by storj-sim already has the values
+	config := testModularConfig()
+	for key, expected := range modularReadNowConfig {
+		require.Equal(t, expected, config[key])
+	}
+}
