+	return nil, ErrNullClient
+}
+
+func (nullInvoiceItems) List(listParams *stripe.InvoiceItemListParams) *invoiceitem.Iter {
+	return &invoiceitem.Iter{Iter: stripe.GetIter(listParams, nullEmptyQuery)}
+}
+
+func (nullInvoiceItems) Del(id string, params *stripe.InvoiceItemParams) (*stripe.InvoiceItem, error) {
+	return nil, ErrNullClient
+}
+
+type nullCustomerBalanceTransactions struct{}
+
+func (nullCustomerBalanceTransactions) New(params *stripe.CustomerBalanceTransactionParams) (*stripe.CustomerBalanceTransaction, error) {
+	return nil, ErrNullClient
+}
+
+func (nullCustomerBalanceTransactions) List(listParams *stripe.CustomerBalanceTransactionListParams) *customerbalancetransaction.Iter {
+	return &customerbalancetransaction.Iter{Iter: stripe.GetIter(listParams, nullEmptyQuery)}
+}
