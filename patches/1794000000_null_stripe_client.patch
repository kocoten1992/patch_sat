+// ErrNullClient is returned by the null Stripe client for every operation that would create or move
+// money, so that nothing silently pretends to have charged, invoiced or credited a customer.
+var ErrNullClient = Error.New("payments provider is \"none\": Stripe is not available")
+
+// NullCustomerIDPrefix is the prefix of the customer IDs created by the null Stripe client.
+const NullCustomerIDPrefix = "cus_null_"
+
+// NewNullClient creates a Stripe client that never talks to Stripe and keeps no state.
+//
+// It's meant for satellites that don't use Stripe at all (payments.provider: none), so that the
+// pricing parts of the payments service keep working:
+//   - creating a customer succeeds with an ID like "cus_null_<uuid>", and customers can be read and
+//     updated (an empty customer is returned),
+//   - every list is empty,
+//   - every operation that would create or move money, or that refers to an object that can't
+//     exist (an invoice, a card, ...), fails with ErrNullClient.
+func NewNullClient() Client {
+	return newNullClient()
+}
+
+func newNullClient() *nullStripeClient {
+	return &nullStripeClient{}
+}
+
+type nullStripeClient struct{}
+
+func (nullStripeClient) Customers() Customers           { return nullCustomers{} }
+func (nullStripeClient) PaymentMethods() PaymentMethods { return nullPaymentMethods{} }
+func (nullStripeClient) PaymentIntents() PaymentIntents { return nullPaymentIntents{} }
+func (nullStripeClient) SetupIntents() SetupIntents     { return nullSetupIntents{} }
+func (nullStripeClient) Invoices() Invoices             { return nullInvoices{} }
+func (nullStripeClient) InvoiceItems() InvoiceItems     { return nullInvoiceItems{} }
+func (nullStripeClient) CustomerBalanceTransactions() CustomerBalanceTransactions {
+	return nullCustomerBalanceTransactions{}
+}
+func (nullStripeClient) Charges() Charges         { return nullCharges{} }
+func (nullStripeClient) PromoCodes() PromoCodes   { return nullPromoCodes{} }
+func (nullStripeClient) CreditNotes() CreditNotes { return nullCreditNotes{} }
+func (nullStripeClient) TaxIDs() TaxIDs           { return nullTaxIDs{} }
+
+// nullEmptyQuery is a list query with no results.
+func nullEmptyQuery(*stripe.Params, *form.Values) ([]interface{}, stripe.ListContainer, error) {
+	return nil, newListContainer(&stripe.ListMeta{}), nil
+}
+
+type nullCustomers struct{}
+
+func (nullCustomers) New(params *stripe.CustomerParams) (*stripe.Customer, error) {
+	id, err := uuid.New()
+	if err != nil {
+		return nil, Error.Wrap(err)
+	}
+	cus := &stripe.Customer{ID: NullCustomerIDPrefix + id.String()}
+	if params != nil && params.Email != nil {
+		cus.Email = *params.Email
+	}
+	return cus, nil
+}
+
+func (nullCustomers) Get(id string, params *stripe.CustomerParams) (*stripe.Customer, error) {
+	return &stripe.Customer{ID: id}, nil
+}
+
+func (nullCustomers) Update(id string, params *stripe.CustomerParams) (*stripe.Customer, error) {
+	cus := &stripe.Customer{ID: id}
+	if params != nil && params.Email != nil {
+		cus.Email = *params.Email
+	}
+	return cus, nil
+}
+
+func (nullCustomers) List(listParams *stripe.CustomerListParams) *customer.Iter {
+	return &customer.Iter{Iter: stripe.GetIter(listParams, nullEmptyQuery)}
+}
+
+type nullPaymentMethods struct{}
+
+func (nullPaymentMethods) List(listParams *stripe.PaymentMethodListParams) *paymentmethod.Iter {
+	return &paymentmethod.Iter{Iter: stripe.GetIter(listParams, nullEmptyQuery)}
+}
+
+func (nullPaymentMethods) New(params *stripe.PaymentMethodParams) (*stripe.PaymentMethod, error) {
+	return nil, ErrNullClient
+}
+
+func (nullPaymentMethods) Update(id string, params *stripe.PaymentMethodParams) (*stripe.PaymentMethod, error) {
+	return nil, ErrNullClient
+}
+
+func (nullPaymentMethods) Get(id string, params *stripe.PaymentMethodParams) (*stripe.PaymentMethod, error) {
+	return nil, ErrNullClient
+}
+
+func (nullPaymentMethods) Attach(id string, params *stripe.PaymentMethodAttachParams) (*stripe.PaymentMethod, error) {
+	return nil, ErrNullClient
+}
+
+func (nullPaymentMethods) Detach(id string, params *stripe.PaymentMethodDetachParams) (*stripe.PaymentMethod, error) {
+	return nil, ErrNullClient
+}
+
+type nullPaymentIntents struct{}
+
+func (nullPaymentIntents) New(params *stripe.PaymentIntentParams) (*stripe.PaymentIntent, error) {
+	return nil, ErrNullClient
+}
+
+type nullSetupIntents struct{}
+
+func (nullSetupIntents) New(params *stripe.SetupIntentParams) (*stripe.SetupIntent, error) {
+	return nil, ErrNullClient
+}
+
+type nullInvoices struct{}
+
+func (nullInvoices) New(params *stripe.InvoiceParams) (*stripe.Invoice, error) {
+	return nil, ErrNullClient
+}
+
+func (nullInvoices) List(listParams *stripe.InvoiceListParams) *invoice.Iter {
+	return &invoice.Iter{Iter: stripe.GetIter(listParams, nullEmptyQuery)}
+}
+
+func (nullInvoices) Update(id string, params *stripe.InvoiceParams) (*stripe.Invoice, error) {
+	return nil, ErrNullClient
+}
+
+func (nullInvoices) FinalizeInvoice(id string, params *stripe.InvoiceFinalizeInvoiceParams) (*stripe.Invoice, error) {
+	return nil, ErrNullClient
+}
+
+func (nullInvoices) Pay(id string, params *stripe.InvoicePayParams) (*stripe.Invoice, error) {
+	return nil, ErrNullClient
+}
+
+func (nullInvoices) Del(id string, params *stripe.InvoiceParams) (*stripe.Invoice, error) {
+	return nil, ErrNullClient
+}
+
+func (nullInvoices) Get(id string, params *stripe.InvoiceParams) (*stripe.Invoice, error) {
+	return nil, ErrNullClient
+}
+
+func (nullInvoices) MarkUncollectible(id string, params *stripe.InvoiceMarkUncollectibleParams) (*stripe.Invoice, error) {
+	return nil, ErrNullClient
+}
+
+func (nullInvoices) VoidInvoice(id string, params *stripe.InvoiceVoidInvoiceParams) (*stripe.Invoice, error) {
+	return nil, ErrNullClient
+}
+
+type nullInvoiceItems struct{}
+
+func (nullInvoiceItems) New(params *stripe.InvoiceItemParams) (*stripe.InvoiceItem, error) {
+	return nil, ErrNullClient
+}
+
