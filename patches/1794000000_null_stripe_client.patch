+// Copyright (C) 2026 StorkSpace Labs, Inc.
+// See LICENSE for copying information.
+
+package stripe_test
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	stripeapi "github.com/stripe/stripe-go/v81"
+	"go.uber.org/zap/zaptest"
+
+	"storj.io/common/testcontext"
+	"storj.io/common/testrand"
+	"storj.io/storj/private/testplanet"
+	"storj.io/storj/satellite/console"
+	"storj.io/storj/satellite/payments/paymentsconfig"
+	"storj.io/storj/satellite/payments/stripe"
+)
+
+func TestNullClient(t *testing.T) {
+	client := stripe.NewNullClient()
+
+	cus, err := client.Customers().New(&stripeapi.CustomerParams{Email: stripeapi.String("user@example.test")})
+	require.NoError(t, err)
+	require.True(t, strings.HasPrefix(cus.ID, stripe.NullCustomerIDPrefix), cus.ID)
+	require.Equal(t, "user@example.test", cus.Email)
+
+	other, err := client.Customers().New(nil)
+	require.NoError(t, err)
+	require.NotEqual(t, cus.ID, other.ID)
+
+	got, err := client.Customers().Get(cus.ID, nil)
+	require.NoError(t, err)
+	require.Equal(t, cus.ID, got.ID)
+
+	updated, err := client.Customers().Update(cus.ID, &stripeapi.CustomerParams{Email: stripeapi.String("new@example.test")})
+	require.NoError(t, err)
+	require.Equal(t, "new@example.test", updated.Email)
+
+	// every list is empty.
+	customers := client.Customers().List(&stripeapi.CustomerListParams{})
+	require.False(t, customers.Next())
+	require.NoError(t, customers.Err())
+
+	paymentMethods := client.PaymentMethods().List(&stripeapi.PaymentMethodListParams{})
+	require.False(t, paymentMethods.Next())
+	require.NoError(t, paymentMethods.Err())
+
+	invoices := client.Invoices().List(&stripeapi.InvoiceListParams{})
+	require.False(t, invoices.Next())
+	require.NoError(t, invoices.Err())
+
+	invoiceItems := client.InvoiceItems().List(&stripeapi.InvoiceItemListParams{})
+	require.False(t, invoiceItems.Next())
+	require.NoError(t, invoiceItems.Err())
+
+	balanceTxs := client.CustomerBalanceTransactions().List(&stripeapi.CustomerBalanceTransactionListParams{Customer: stripeapi.String(cus.ID)})
+	require.False(t, balanceTxs.Next())
+	require.NoError(t, balanceTxs.Err())
+
+	charges := client.Charges().List(&stripeapi.ChargeListParams{})
+	require.False(t, charges.Next())
+	require.NoError(t, charges.Err())
+
+	promoCodes := client.PromoCodes().List(&stripeapi.PromotionCodeListParams{Code: stripeapi.String("promo")})
+	require.False(t, promoCodes.Next())
+	require.NoError(t, promoCodes.Err())
+
+	// nothing that would create or move money succeeds.
+	requireNull := func(_ any, err error) {
+		t.Helper()
+		require.ErrorIs(t, err, stripe.ErrNullClient)
+	}
+	requireNull(client.PaymentMethods().New(&stripeapi.PaymentMethodParams{}))
+	requireNull(client.PaymentMethods().Get("pm_1", nil))
+	requireNull(client.PaymentMethods().Update("pm_1", nil))
+	requireNull(client.PaymentMethods().Attach("pm_1", nil))
+	requireNull(client.PaymentMethods().Detach("pm_1", nil))
+	requireNull(client.PaymentIntents().New(&stripeapi.PaymentIntentParams{}))
+	requireNull(client.SetupIntents().New(&stripeapi.SetupIntentParams{}))
+	requireNull(client.Invoices().New(&stripeapi.InvoiceParams{}))
+	requireNull(client.Invoices().Get("in_1", nil))
+	requireNull(client.Invoices().Update("in_1", nil))
+	requireNull(client.Invoices().FinalizeInvoice("in_1", nil))
+	requireNull(client.Invoices().Pay("in_1", nil))
+	requireNull(client.Invoices().Del("in_1", nil))
+	requireNull(client.Invoices().MarkUncollectible("in_1", nil))
+	requireNull(client.Invoices().VoidInvoice("in_1", nil))
+	requireNull(client.InvoiceItems().New(&stripeapi.InvoiceItemParams{}))
+	requireNull(client.InvoiceItems().Update("ii_1", nil))
+	requireNull(client.InvoiceItems().Del("ii_1", nil))
+	requireNull(client.CustomerBalanceTransactions().New(&stripeapi.CustomerBalanceTransactionParams{}))
+	requireNull(client.CreditNotes().New(&stripeapi.CreditNoteParams{}))
+	requireNull(client.TaxIDs().New(&stripeapi.TaxIDParams{}))
+	requireNull(client.TaxIDs().Del("txi_1", nil))
+}
+
+// TestNullClientService checks that the payments service works on top of the null client in the
+// ways a satellite without Stripe uses it: setting up customers, the account deletion checks,
+// changing a customer's email and pricing usage.
+func TestNullClientService(t *testing.T) {
+	testplanet.Run(t, testplanet.Config{SatelliteCount: 1}, func(t *testing.T, ctx *testcontext.Context, planet *testplanet.Planet) {
+		sat := planet.Satellites[0]
+		db := sat.DB
+
+		pc := paymentsconfig.Config{
+			UsagePrice: paymentsconfig.ProjectUsagePrice{
+				StorageTB: "4",
+				EgressTB:  "7",
+				Segment:   "0.0000088",
+			},
+		}
+		prices, err := pc.UsagePrice.ToModel()
+		require.NoError(t, err)
+		priceOverrides, err := pc.UsagePriceOverrides.ToModels()
+		require.NoError(t, err)
+		productPrices, err := pc.Products.ToModels()
+		require.NoError(t, err)
+		minimumChargeDate, err := pc.MinimumCharge.GetEffectiveDate()
+		require.NoError(t, err)
+
+		service, err := stripe.NewService(
+			zaptest.NewLogger(t),
+			stripe.NewNullClient(),
+			stripe.ServiceDependencies{
+				DB:                   db.StripeCoinPayments(),
+				WalletsDB:            db.Wallets(),
+				BillingDB:            db.Billing(),
+				ProjectsDB:           db.Console().Projects(),
+				UsersDB:              db.Console().Users(),
+				FreezeEventsDB:       db.Console().AccountFreezeEvents(),
+				UsageDB:              db.ProjectAccounting(),
+				RetentionRemainderDB: db.RetentionRemainderCharges(),
+				Entitlements:         sat.API.Entitlements.Service,
+			},
+			stripe.ServiceConfig{
+				DeleteProjectCostThreshold: pc.DeleteProjectCostThreshold,
+				EntitlementsEnabled:        sat.Config.Entitlements.Enabled,
+			},
+			pc.StripeCoinPayments,
+			stripe.PricingConfig{
+				UsagePrices:         prices,
+				UsagePriceOverrides: priceOverrides,
+				ProductPriceMap:     productPrices,
+				PlacementProductMap: pc.PlacementPriceOverrides.ToMap(),
+				PackagePlans:        pc.PackagePlans.Packages,
+				BonusRate:           pc.BonusRate,
+				MinimumChargeAmount: pc.MinimumCharge.Amount,
+				MinimumChargeDate:   minimumChargeDate,
+			},
+		)
+		require.NoError(t, err)
+		accounts := service.Accounts()
+
+		// insert the user directly: testplanet's AddUser would set up a customer with the mock.
+		user, err := db.Console().Users().Insert(ctx, &console.User{
+			ID:           testrand.UUID(),
+			FullName:     "Null Client",
+			Email:        "null-client@example.test",
+			PasswordHash: testrand.Bytes(8),
+		})
+		require.NoError(t, err)
+
+		// a user without a customer row (billing features off never creates one) is handled as before.
+		_, err = db.StripeCoinPayments().Customers().GetCustomerID(ctx, user.ID)
+		require.ErrorIs(t, err, stripe.ErrNoCustomer)
+
+		invoices, err := accounts.Invoices().List(ctx, &user.ID)
+		require.NoError(t, err)
+		require.Empty(t, invoices)
+
+		// setting up a customer stores a null customer ID, and doing it again is a no-op.
+		_, err = accounts.Setup(ctx, user.ID, user.Email, "")
+		require.NoError(t, err)
+		cusID, err := db.StripeCoinPayments().Customers().GetCustomerID(ctx, user.ID)
+		require.NoError(t, err)
+		require.True(t, strings.HasPrefix(cusID, stripe.NullCustomerIDPrefix), cusID)
+
+		_, err = accounts.Setup(ctx, user.ID, user.Email, "some-promo-code")
+		require.NoError(t, err)
+		sameID, err := db.StripeCoinPayments().Customers().GetCustomerID(ctx, user.ID)
+		require.NoError(t, err)
+		require.Equal(t, cusID, sameID)
+
+		// the account deletion checks find nothing to block on, and removing cards succeeds.
+		invoices, err = accounts.Invoices().List(ctx, &user.ID)
+		require.NoError(t, err)
+		require.Empty(t, invoices)
+
+		pending, err := accounts.Invoices().CheckPendingItems(ctx, user.ID)
+		require.NoError(t, err)
+		require.False(t, pending)
+
+		cards, err := accounts.CreditCards().List(ctx, user.ID)
+		require.NoError(t, err)
+		require.Empty(t, cards)
+		require.NoError(t, accounts.CreditCards().RemoveAll(ctx, user.ID))
+
+		// the admin "change user email" path.
+		require.NoError(t, accounts.ChangeCustomerEmail(ctx, user.ID, cusID, "changed@example.test"))
+
+		balance, err := accounts.Balances().Get(ctx, user.ID)
+		require.NoError(t, err)
+		require.True(t, balance.Credits.IsZero())
+
+		// pricing doesn't need Stripe.
+		project, err := sat.AddProject(ctx, user.ID, "null-client")
+		require.NoError(t, err)
+		now := time.Now()
+		charges, err := accounts.ProjectProductCharges(ctx, project.ID, project.PublicID, now.Add(-time.Hour), now)
+		require.NoError(t, err)
+		require.NotNil(t, charges)
+
+		// moving money fails loudly instead of pretending it happened.
+		_, err = accounts.Balances().ApplyCredit(ctx, user.ID, 100, "credit", "")
+		require.ErrorIs(t, err, stripe.ErrNullClient)
+	})
+}
