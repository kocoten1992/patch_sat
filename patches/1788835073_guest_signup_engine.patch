+func TestCreateUserGuestEmailAutoActivates(t *testing.T) {
+	testplanet.Run(t, testplanet.Config{
+		SatelliteCount: 1,
+	}, func(t *testing.T, ctx *testcontext.Context, planet *testplanet.Planet) {
+		sat := planet.Satellites[0]
+		service := sat.API.Console.Service
+
+		t.Run("guest email with no name", func(t *testing.T) {
+			user, err := service.CreateUser(ctx, console.CreateUser{
+				Email:       "11111111222233334444555566667777@example.net",
+				Password:    "11111111222233334444555566667777@example.net",
+				AllowNoName: true,
+			}, nil)
+			require.NoError(t, err)
+			require.Equal(t, console.Active, user.Status)
+		})
+
+		t.Run("non-guest email with no name", func(t *testing.T) {
+			user, err := service.CreateUser(ctx, console.CreateUser{
+				Email:       "no-name@mail.test",
+				Password:    "a-real-password",
+				AllowNoName: true,
+			}, nil)
+			require.NoError(t, err)
+			require.Equal(t, console.Inactive, user.Status)
+		})
+
+		t.Run("non-guest email", func(t *testing.T) {
+			user, err := service.CreateUser(ctx, console.CreateUser{
+				FullName: "Real Person",
+				Email:    "real-person@mail.test",
+				Password: "a-real-password",
+			}, nil)
+			require.NoError(t, err)
+			require.Equal(t, console.Inactive, user.Status)
+			require.Equal(t, "Real Person", user.FullName)
+		})
+	})
+}
