+// TestingDeleteAll deletes all rows from every table in the dbx schema, leaving
+// the schema itself and the migration version intact, so that the database can
+// be recycled by another test rather than dropped and recreated.
+//
+// This mirrors metabase.Adapter.TestingDeleteAll.
+//
+// It deliberately uses DELETE and not TRUNCATE. On CockroachDB, TRUNCATE is a
+// descriptor swap that marks the old table for GC, so it is a schema change and
+// schedules exactly the GC work that recycling exists to avoid. On TiDB it bumps
+// the schema version. DELETE is plain DML on every backend.
+//
+// The versions table is created by the migration rather than by dbx, so
+// dbx.DeleteAll does not touch it and the database stays at the latest version.
+func (db *satelliteDBTesting) TestingDeleteAll(ctx context.Context) (err error) {
+	if _, err := dbx.DeleteAll(ctx, db.satelliteDB.DB); err != nil {
+		return Error.Wrap(err)
+	}
+	return Error.Wrap(db.testingResetSequences(ctx))
+}
+
+// testingResetSequences rewinds every sequence in the current schema. DELETE
+// does not reset them, so without this a recycled database keeps handing out
+// ever-climbing generated ids.
+func (db *satelliteDBTesting) testingResetSequences(ctx context.Context) (err error) {
+	rows, err := db.satelliteDB.DB.QueryContext(ctx,
+		"SELECT sequence_name FROM information_schema.sequences WHERE sequence_schema = CURRENT_SCHEMA")
+	if err != nil {
+		return err
+	}
+
+	var names []string
+	for rows.Next() {
+		var name string
+		if err := rows.Scan(&name); err != nil {
+			return errs.Combine(err, rows.Close())
+		}
+		names = append(names, name)
+	}
+	if err := errs.Combine(rows.Err(), rows.Close()); err != nil {
+		return err
+	}
+
+	for _, name := range names {
+		if _, err := db.satelliteDB.DB.ExecContext(ctx,
+			"SELECT setval($1::regclass, 1, false)", name); err != nil {
+			return errs.New("resetting sequence %q: %w", name, err)
+		}
+	}
+	return nil
+}
