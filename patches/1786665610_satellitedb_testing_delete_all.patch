@@ -0,0 +1,91 @@
+// Copyright (C) 2026 StorkSpace Labs, Inc.
+// See LICENSE for copying information.
+
+package satellitedb_test
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"storj.io/common/testcontext"
+	"storj.io/common/testrand"
+	"storj.io/storj/satellite"
+	"storj.io/storj/satellite/console"
+	"storj.io/storj/satellite/satellitedb/satellitedbtest"
+)
+
+// TestTestingDeleteAllReuse proves the two premises the database-pool design
+// rests on:
+//
+//  1. dbx.DeleteAll clears every table without tripping a foreign key, with real
+//     data present, and leaves the versions row alone.
+//  2. TestMigrateToLatest is a no-op against an already-migrated database, so a
+//     recycled database is indistinguishable from a fresh one.
+func TestTestingDeleteAllReuse(t *testing.T) {
+	satellitedbtest.Run(t, func(ctx *testcontext.Context, t *testing.T, db satellite.DB) {
+		raw := db.Testing().RawDB()
+
+		count := func(table string) (n int) {
+			require.NoError(t, raw.QueryRowContext(ctx, "SELECT count(*) FROM "+table).Scan(&n))
+			return n
+		}
+
+		// Seed across the foreign key graph: project_members references both
+		// users and projects, so dbx.DeleteAll must delete it before either
+		// parent. This is the ordering that a naive delete loop gets wrong.
+		seed := func() {
+			projectID := testrand.UUID()
+			_, err := db.Console().Projects().Insert(ctx, &console.Project{ID: projectID})
+			require.NoError(t, err)
+
+			user, err := db.Console().Users().Insert(ctx, &console.User{
+				ID:           testrand.UUID(),
+				FullName:     "Alice",
+				ShortName:    "A",
+				Email:        "alice@mail.test",
+				PasswordHash: testrand.Bytes(8),
+			})
+			require.NoError(t, err)
+
+			_, err = db.Console().ProjectMembers().Insert(ctx, user.ID, projectID, console.RoleAdmin)
+			require.NoError(t, err)
+		}
+
+		seed()
+		require.Equal(t, 1, count("users"))
+		require.Equal(t, 1, count("projects"))
+		require.Equal(t, 1, count("project_members"))
+
+		var versionBefore int
+		require.NoError(t, raw.QueryRowContext(ctx, "SELECT max(version) FROM versions").Scan(&versionBefore))
+		t.Logf("versions before reset: %d", versionBefore)
+
+		// Premise 1.
+		start := time.Now()
+		require.NoError(t, db.Testing().TestingDeleteAll(ctx))
+		t.Logf("TestingDeleteAll took %v", time.Since(start))
+
+		require.Zero(t, count("users"))
+		require.Zero(t, count("projects"))
+		require.Zero(t, count("project_members"))
+
+		var versionAfter int
+		require.NoError(t, raw.QueryRowContext(ctx, "SELECT max(version) FROM versions").Scan(&versionAfter))
+		require.Equal(t, versionBefore, versionAfter, "reset must not disturb the migration version")
+
+		// Premise 2.
+		start = time.Now()
+		require.NoError(t, db.Testing().TestMigrateToLatest(ctx))
+		t.Logf("TestMigrateToLatest on a recycled db took %v", time.Since(start))
+
+		// And the database is genuinely usable again.
+		seed()
+		require.Equal(t, 1, count("users"))
+		require.Equal(t, 1, count("project_members"))
+
+		require.NoError(t, db.Testing().TestingDeleteAll(ctx))
+		require.Zero(t, count("users"))
+	})
+}
