+// Copyright (C) 2026 StorkSpace Labs, Inc.
+// See LICENSE for copying information.
+
+package pgretry
+
+import (
+	"context"
+	"database/sql"
+	"database/sql/driver"
+	"errors"
+	"io"
+
+	"github.com/jackc/pgx/v5/stdlib"
+	"github.com/spacemonkeygo/monkit/v3"
+	"github.com/zeebo/errs"
+
+	"storj.io/storj/shared/dbutil/retrydb"
+)
+
+var mon = monkit.Package()
+
+// Driver is the type for the "pgretry" sql/database driver. It uses
+// github.com/jackc/pgx/v5/stdlib under the covers, and differs from using
+// "pgx" directly only in that conflicting statements are retried.
+type Driver struct {
+	pgxDriver stdlib.Driver
+}
+
+// Open opens a new connection.
+func (d *Driver) Open(name string) (driver.Conn, error) {
+	conn, err := d.pgxDriver.Open(name)
+	if err != nil {
+		return nil, err
+	}
+	pgxStdlibConn, ok := conn.(*stdlib.Conn)
+	if !ok {
+		return nil, errs.New("Conn from pgx is not a *stdlib.Conn??? T: %T", conn)
+	}
+	return &retryConn{pgxStdlibConn}, nil
+}
+
+// OpenConnector obtains a new db Connector, which sql.DB can use to
+// obtain each needed connection at the appropriate time.
+func (d *Driver) OpenConnector(name string) (driver.Connector, error) {
+	pgxConnector, err := d.pgxDriver.OpenConnector(name)
+	if err != nil {
+		return nil, err
+	}
+	return &retryConnector{driver: d, pgxConnector: pgxConnector}, nil
+}
+
+// retryConnector is a thin wrapper around a pgx-based connector. This allows
+// Driver to supply our custom retryConn type for connections.
+type retryConnector struct {
+	driver       *Driver
+	pgxConnector driver.Connector
+}
+
+// Driver returns the driver being used for this connector.
+func (c *retryConnector) Driver() driver.Driver {
+	return c.driver
+}
+
+// Connect creates a new connection using the connector.
+func (c *retryConnector) Connect(ctx context.Context) (driver.Conn, error) {
+	pgxConn, err := c.pgxConnector.Connect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	pgxStdlibConn, ok := pgxConn.(*stdlib.Conn)
+	if !ok {
+		return nil, errs.New("Conn from pgx is not a *stdlib.Conn??? T: %T", pgxConn)
+	}
+	return &retryConn{pgxStdlibConn}, nil
+}
+
+type connAll interface {
+	driver.Conn
+	driver.ConnBeginTx
+	driver.ExecerContext
+	driver.QueryerContext
+	driver.Pinger
+	driver.NamedValueChecker
+}
+
+// retryConn is a connection to a database. It is not used concurrently by multiple goroutines.
+type retryConn struct {
+	underlying *stdlib.Conn
+}
+
+// Assert that retryConn fulfills connAll.
+var _ connAll = (*retryConn)(nil)
+
+// StdlibConn returns the underlying pgx std connection. pgxutil.Conn looks for
+// this method, so CopyFrom and other raw-conn users keep working.
+func (c *retryConn) StdlibConn() *stdlib.Conn { return c.underlying }
+
+// Close closes the retryConn.
+func (c *retryConn) Close() error {
+	return c.underlying.Close()
+}
+
+// Ping checks if the retryConn is reachable.
+func (c *retryConn) Ping(ctx context.Context) error {
+	return c.underlying.Ping(ctx)
+}
+
+// CheckNamedValue implements the driver.NamedValueChecker interface. Implementing this method
+// allows pgx.NamedArgs and pgx.StrictNamedArgs to be used as query arguments.
+func (c *retryConn) CheckNamedValue(nv *driver.NamedValue) error {
+	return c.underlying.CheckNamedValue(nv)
+}
+
+// ExecContext (when implemented by a driver.Conn) provides ExecContext
+// functionality to a sql.DB instance. This implementation provides
+// retry semantics for single statements.
+func (c *retryConn) ExecContext(ctx context.Context, query string, args []driver.NamedValue) (driver.Result, error) {
+	return retrydb.RetryConflict(mon, c.isInTransaction, func() (driver.Result, error) {
+		return c.underlying.ExecContext(ctx, query, args)
+	})
+}
+
+type retryRows struct {
+	rows         driver.Rows
+	firstResults []driver.Value
+	eof          bool
+}
+
+// Columns returns the names of the columns.
+func (rows *retryRows) Columns() []string {
+	return rows.rows.Columns()
+}
+
+// Close closes the rows iterator.
+func (rows *retryRows) Close() error {
+	return rows.rows.Close()
+}
+
+// Next implements the Next method on driver.Rows.
+func (rows *retryRows) Next(dest []driver.Value) error {
+	if rows.eof {
+		return io.EOF
+	}
+	if rows.firstResults == nil {
+		return rows.rows.Next(dest)
+	}
+	copy(dest, rows.firstResults)
+	rows.firstResults = nil
+	return nil
+}
+
+// wrapRows pre-fetches the first row so that a retryable error CockroachDB
+// surfaces only once results start streaming is caught here, where the query
+// can still be replayed, rather than half way through the caller's scan.
+func wrapRows(rows driver.Rows) (wrapped *retryRows, err error) {
+	columns := rows.Columns()
+	dest := make([]driver.Value, len(columns))
+	err = rows.Next(dest)
+	if err != nil {
+		if errors.Is(err, io.EOF) {
+			return &retryRows{rows: rows, firstResults: nil, eof: true}, nil
+		}
+		return nil, err
+	}
+	return &retryRows{rows: rows, firstResults: dest}, nil
+}
+
+// QueryContext (when implemented by a driver.Conn) provides QueryContext
+// functionality to a sql.DB instance. This implementation provides
+// retry semantics for single statements. Unlike ExecContext, it does not use
+// retrydb.RetryConflict because it also retries errors surfaced by the
+// wrapRows first-row pre-fetch.
+func (c *retryConn) QueryContext(ctx context.Context, query string, args []driver.NamedValue) (_ driver.Rows, err error) {
+	defer mon.Task()(&ctx)(&err)
+	for {
+		result, err := c.underlying.QueryContext(ctx, query, args)
+		if err != nil {
+			if retrydb.ShouldRetry(err) {
+				if c.isInTransaction() {
+					return nil, err
+				}
+				mon.Event("needed_retry")
+				continue
+			}
+			return nil, err
+		}
+		wrappedResult, err := wrapRows(result)
+		if err != nil {
+			// If this returns an error it's probably the same error
+			// we got from calling Next inside wrapRows.
+			_ = result.Close()
+			if retrydb.ShouldRetry(err) {
+				if c.isInTransaction() {
+					return nil, err
+				}
+				mon.Event("needed_retry")
+				continue
+			}
+			return nil, err
+		}
+		return wrappedResult, nil
+	}
+}
+
+// Begin starts a new transaction.
+func (c *retryConn) Begin() (driver.Tx, error) {
+	return c.BeginTx(context.Background(), driver.TxOptions{})
+}
+
+// BeginTx begins a new transaction using the specified context and with the specified options.
+func (c *retryConn) BeginTx(ctx context.Context, opts driver.TxOptions) (driver.Tx, error) {
+	return c.underlying.BeginTx(ctx, opts)
+}
+
+// Prepare prepares a statement for future execution.
+func (c *retryConn) Prepare(query string) (driver.Stmt, error) {
+	pgxStmt, err := c.underlying.Prepare(query)
+	if err != nil {
+		return nil, err
+	}
+	adapted, ok := pgxStmt.(retrydb.StmtAll)
+	if !ok {
+		return nil, errs.New("Stmt type %T does not provide context interfaces", pgxStmt)
+	}
+	return &retryStmt{underlyingStmt: adapted, conn: c}, nil
+}
+
+type transactionStatus byte
+
+const (
+	txnStatusIdleInTransaction   transactionStatus = 'T'
+	txnStatusInFailedTransaction transactionStatus = 'E'
+)
+
+func (c *retryConn) txnStatus() transactionStatus {
+	pgConn := c.underlying.Conn().PgConn()
+	return transactionStatus(pgConn.TxStatus())
+}
+
+func (c *retryConn) isInTransaction() bool {
+	txnStatus := c.txnStatus()
+	return txnStatus == txnStatusIdleInTransaction || txnStatus == txnStatusInFailedTransaction
+}
+
+type retryStmt struct {
+	underlyingStmt retrydb.StmtAll
+	conn           *retryConn
+}
+
+// Assert that retryStmt satisfies StmtExecContext and StmtQueryContext.
+var _ retrydb.StmtAll = (*retryStmt)(nil)
+
+// Close closes a prepared statement.
+func (stmt *retryStmt) Close() error {
+	return stmt.underlyingStmt.Close()
+}
+
+// NumInput returns the number of placeholder parameters.
+func (stmt *retryStmt) NumInput() int {
+	return stmt.underlyingStmt.NumInput()
+}
+
+// Exec / Query forward to *Context so callers using the deprecated API still
+// pick up retry-on-conflict semantics.
+func (stmt *retryStmt) Exec(args []driver.Value) (driver.Result, error) {
+	return stmt.ExecContext(context.Background(), retrydb.ValuesToNamed(args))
+}
+
+func (stmt *retryStmt) Query(args []driver.Value) (driver.Rows, error) {
+	return stmt.QueryContext(context.Background(), retrydb.ValuesToNamed(args))
+}
+
+// ExecContext executes SQL statements in the specified context.
+func (stmt *retryStmt) ExecContext(ctx context.Context, args []driver.NamedValue) (driver.Result, error) {
+	return retrydb.RetryConflict(mon, stmt.conn.isInTransaction, func() (driver.Result, error) {
+		return stmt.underlyingStmt.ExecContext(ctx, args)
+	})
+}
+
+// QueryContext executes a query in the specified context.
+func (stmt *retryStmt) QueryContext(ctx context.Context, args []driver.NamedValue) (_ driver.Rows, err error) {
+	defer mon.Task()(&ctx)(&err)
+	for {
+		result, err := stmt.underlyingStmt.QueryContext(ctx, args)
+		if err != nil {
+			if retrydb.ShouldRetry(err) {
+				if stmt.conn.isInTransaction() {
+					return nil, err
+				}
+				mon.Event("needed_retry")
+				continue
+			}
+			return nil, err
+		}
+		wrappedResult, err := wrapRows(result)
+		if err != nil {
+			// If this returns an error it's probably the same error
+			// we got from calling Next inside wrapRows.
+			_ = result.Close()
+			if retrydb.ShouldRetry(err) {
+				if stmt.conn.isInTransaction() {
+					return nil, err
+				}
+				mon.Event("needed_retry")
+				continue
+			}
+			return nil, err
+		}
+		return wrappedResult, nil
+	}
+}
+
+// DriverName is the name this driver is registered under.
+const DriverName = "pgretry"
+
+var defaultDriver = &Driver{}
+
+func init() {
+	sql.Register(DriverName, defaultDriver)
+}
