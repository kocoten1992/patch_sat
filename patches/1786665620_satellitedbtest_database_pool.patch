+// Copyright (C) 2026 StorkSpace Labs, Inc.
+// See LICENSE for copying information.
+
+package satellitedbtest
+
+import (
+	"context"
+	"flag"
+	"os"
+	"sync"
+
+	"github.com/spacemonkeygo/monkit/v3"
+	"go.uber.org/zap"
+
+	"storj.io/storj/shared/dbutil"
+	"storj.io/storj/shared/dbutil/tempdb"
+	"storj.io/storj/shared/tagsql"
+)
+
+var mon = monkit.Package()
+
+// dbPoolEnabled turns on reuse of test databases.
+//
+// Creating a database and running the migration costs seconds; deleting every
+// row from an already-migrated database costs tens of milliseconds. On
+// CockroachDB the create/drop cycle is worse than merely slow, because every
+// dropped database schedules a schema-change GC job and a wide test run
+// generates them faster than the cluster drains them.
+var dbPoolEnabled = flag.Bool("db-pool", stringToBool(os.Getenv("STORJ_TEST_DB_POOL")),
+	"Reuse test databases by deleting their rows instead of dropping and recreating them")
+
+// poolEntry is a database that has been created and migrated, and is currently
+// free. Only the metadata is kept: TempDatabase.Close unconditionally closes the
+// underlying connection, so a pooled database is reopened on each acquire rather
+// than held open. The connection string already points at the temporary database
+// (or schema), so reopening it works for every backend without the pool needing
+// to know which one is in use.
+type poolEntry struct {
+	connStr string
+	schema  string
+	driver  string
+	impl    dbutil.Implementation
+}
+
+// dbPool hands out reusable test databases.
+//
+// It grows on demand rather than holding a fixed number of databases, and never
+// blocks waiting for one to come free. That is required, not merely convenient:
+// satellitedbtest.Run and metabasetest.Run both call t.Parallel(), and a single
+// multi-satellite testplanet acquires a master and a metabase database per
+// satellite, so a test holding one database can be waiting on another. A fixed
+// pool would deadlock. Growing on demand converges on actual peak concurrency
+// and then issues no further DDL.
+type dbPool struct {
+	mu   sync.Mutex
+	free map[string][]poolEntry
+
+	// recycled records, by connection string, whether the database handed out
+	// under that string came off the free list and therefore still holds the
+	// previous holder's rows. The reset is left to the caller because only the
+	// caller has a typed handle that knows the schema.
+	recycled map[string]bool
+}
+
+var pool = &dbPool{
+	free:     map[string][]poolEntry{},
+	recycled: map[string]bool{},
+}
+
+// openTestDB returns a temporary database for a test, from the pool when pooling
+// is enabled and a pool key was supplied, and by creating a fresh one otherwise.
+//
+// An empty poolKey disables pooling for that call site. Pooling is only safe
+// where the caller resets a recycled database before handing it to the test, so
+// it is opt-in per call site rather than on by default.
+func openTestDB(ctx context.Context, log *zap.Logger, connURL, namePrefix, poolKey string) (*dbutil.TempDatabase, error) {
+	if *dbPoolEnabled && poolKey != "" {
+		return pool.acquire(ctx, log, poolKey, connURL, namePrefix)
+	}
+
+	tempDB, err := tempdb.OpenUnique(ctx, log, connURL, namePrefix)
+	if err != nil {
+		return nil, err
+	}
+	if *cockroachNoDrop && tempDB.Driver == "cockroach" {
+		tempDB.Cleanup = func(tagsql.DB) error { return nil }
+	}
+	return tempDB, nil
+}
+
+// acquire returns a database from the free list for key, or creates one when the
+// list is empty.
+func (p *dbPool) acquire(ctx context.Context, log *zap.Logger, key, connURL, namePrefix string) (*dbutil.TempDatabase, error) {
+	var entry poolEntry
+	var reused bool
+
+	p.mu.Lock()
+	if n := len(p.free[key]); n > 0 {
+		entry, p.free[key] = p.free[key][n-1], p.free[key][:n-1]
+		reused = true
+	}
+	p.mu.Unlock()
+
+	if !reused {
+		tempDB, err := tempdb.OpenUnique(ctx, log, connURL, namePrefix)
+		if err != nil {
+			return nil, err
+		}
+		entry = poolEntry{
+			connStr: tempDB.ConnStr,
+			schema:  tempDB.Schema,
+			driver:  tempDB.Driver,
+			impl:    tempDB.Implementation,
+		}
+		p.setRecycled(entry.connStr, false)
+		tempDB.Cleanup = p.releaseFunc(key, entry)
+		return tempDB, nil
+	}
+
+	db, err := tagsql.Open(ctx, entry.driver, entry.connStr, nil)
+	if err != nil {
+		// The database is unusable; drop it from the pool and start over rather
+		// than handing back a broken handle.
+		return p.acquire(ctx, log, key, connURL, namePrefix)
+	}
+	dbutil.Configure(ctx, db, "tmp_pool", mon)
+	p.setRecycled(entry.connStr, true)
+
+	return &dbutil.TempDatabase{
+		DB:             db,
+		ConnStr:        entry.connStr,
+		Schema:         entry.schema,
+		Driver:         entry.driver,
+		Implementation: entry.impl,
+		Cleanup:        p.releaseFunc(key, entry),
+	}, nil
+}
+
+// releaseFunc returns a TempDatabase cleanup closure that returns the database to
+// the free list instead of dropping it. It is idempotent because TempDatabase
+// values can be closed more than once.
+func (p *dbPool) releaseFunc(key string, entry poolEntry) func(tagsql.DB) error {
+	var once sync.Once
+	return func(tagsql.DB) error {
+		once.Do(func() {
+			p.mu.Lock()
+			p.free[key] = append(p.free[key], entry)
+			p.mu.Unlock()
+		})
+		return nil
+	}
+}
+
+func (p *dbPool) setRecycled(connStr string, v bool) {
+	p.mu.Lock()
+	p.recycled[connStr] = v
+	p.mu.Unlock()
+}
+
+// wasRecycled reports whether the database behind connStr came off the free list
+// and so still holds rows from its previous holder.
+func (p *dbPool) wasRecycled(connStr string) bool {
+	if !*dbPoolEnabled {
+		return false
+	}
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	return p.recycled[connStr]
+}
+
+// PoolStats reports the number of databases currently on the free list, for
+// tests that want to assert the pool is actually being reused.
+func PoolStats() map[string]int {
+	pool.mu.Lock()
+	defer pool.mu.Unlock()
+	out := make(map[string]int, len(pool.free))
+	for k, v := range pool.free {
+		out[k] = len(v)
+	}
+	return out
+}
