diff --git a/web/satellite/src/components/utils/BrandLogo.vue b/web/satellite/src/components/utils/BrandLogo.vue
new file mode 100644
index 0000000..f58f4c7
--- /dev/null
+++ b/web/satellite/src/components/utils/BrandLogo.vue
@@ -0,0 +1,158 @@
+// Copyright (C) 2026 StorkSpace Labs, Inc.
+// See LICENSE for copying information.
+
+<template>
+    <span ref="root" class="brand-logo">
+        <img :src="src" alt="Logo" class="logo-img">
+        <span v-if="displayed !== null" class="brand-logo__text" aria-hidden="true"><span class="brand-logo__sep">{{ separator }}</span>{{ displayed }}</span>
+    </span>
+</template>
+
+<script setup lang="ts">
+import { onBeforeUnmount, onMounted, ref } from 'vue';
+
+const props = withDefaults(defineProps<{
+    src: string;
+    // Text revealed next to the logo on hover. Empty disables the effect.
+    hoverText?: string;
+    // Shown before the text; not part of the logo and not part of the text.
+    separator?: string;
+}>(), {
+    hoverText: '',
+    separator: '//',
+});
+
+const SCRAMBLE_CHARS = '0123456789@#$%&';
+const REVEAL_MS = 1000;
+const HIDE_MS = 300;
+
+const root = ref<HTMLElement | null>(null);
+// null means hidden.
+const displayed = ref<string | null>(null);
+
+let frame = 0;
+let trigger: HTMLElement | null = null;
+
+function randomChar(): string {
+    return SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
+}
+
+function reducedMotion(): boolean {
+    return window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
+}
+
+/**
+ * Returns animation progress in [0, 1]. requestAnimationFrame timestamps are
+ * taken at the start of the frame and can be earlier than a performance.now()
+ * read in an event handler, so the raw value may be slightly negative on the
+ * first frame. Unclamped, that made the first frame longer than the text.
+ */
+function progressOf(start: number, now: number, duration: number): number {
+    return Math.min(Math.max((now - start) / duration, 0), 1);
+}
+
+function cancel(): void {
+    if (frame) cancelAnimationFrame(frame);
+    frame = 0;
+}
+
+/**
+ * Decodes the text from left to right: the resolved prefix stays put while
+ * the remaining characters are re-randomized on every frame.
+ */
+function reveal(): void {
+    cancel();
+    const word = props.hoverText;
+    if (!word) return;
+    if (reducedMotion()) {
+        displayed.value = word;
+        return;
+    }
+
+    const start = performance.now();
+    const step = (now: number) => {
+        const progress = progressOf(start, now, REVEAL_MS);
+        if (progress >= 1) {
+            displayed.value = word;
+            frame = 0;
+            return;
+        }
+        const resolved = Math.floor(progress * word.length);
+        let out = word.slice(0, resolved);
+        for (let i = resolved; i < word.length; i++) {
+            out += word[i] === ' ' ? ' ' : randomChar();
+        }
+        displayed.value = out;
+        frame = requestAnimationFrame(step);
+    };
+    frame = requestAnimationFrame(step);
+}
+
+/**
+ * Removes the text quickly, from right to left.
+ */
+function hide(): void {
+    cancel();
+    const current = displayed.value;
+    if (current === null) return;
+    if (reducedMotion()) {
+        displayed.value = null;
+        return;
+    }
+
+    const start = performance.now();
+    const step = (now: number) => {
+        const progress = progressOf(start, now, HIDE_MS);
+        const remaining = Math.ceil(current.length * (1 - progress));
+        if (remaining <= 0) {
+            displayed.value = null;
+            frame = 0;
+            return;
+        }
+        displayed.value = current.slice(0, remaining);
+        frame = requestAnimationFrame(step);
+    };
+    frame = requestAnimationFrame(step);
+}
+
+onMounted(() => {
+    // Listen on the surrounding link/button, so the whole clickable area and
+    // keyboard focus trigger the effect, not only the image itself.
+    trigger = (root.value?.closest('a, button') as HTMLElement | null) ?? root.value;
+    if (!trigger) return;
+    trigger.addEventListener('mouseenter', reveal);
+    trigger.addEventListener('mouseleave', hide);
+    trigger.addEventListener('focus', reveal);
+    trigger.addEventListener('blur', hide);
+});
+
+onBeforeUnmount(() => {
+    cancel();
+    if (!trigger) return;
+    trigger.removeEventListener('mouseenter', reveal);
+    trigger.removeEventListener('mouseleave', hide);
+    trigger.removeEventListener('focus', reveal);
+    trigger.removeEventListener('blur', hide);
+});
+</script>
+
+<style scoped lang="scss">
+.brand-logo {
+    display: inline-flex;
+    align-items: center;
+    white-space: nowrap;
+
+    &__text {
+        margin-left: 2px;
+        font-family: ui-monospace, 'SFMono-Regular', 'Menlo', 'Consolas', 'Liberation Mono', monospace;
+        font-size: 20px;
+        font-weight: 500;
+        line-height: 1;
+        color: rgb(var(--v-theme-on-surface));
+    }
+
+    &__sep {
+        opacity: 0.5;
+    }
+}
+</style>
