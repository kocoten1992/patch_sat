+func TestGuestPasswordNotRequired(t *testing.T) {
+	testplanet.Run(t, testplanet.Config{
+		SatelliteCount: 1,
+		Reconfigure: testplanet.Reconfigure{
+			Satellite: func(log *zap.Logger, index int, config *satellite.Config) {
+				config.Console.EmailChangeFlowEnabled = true
+				config.Console.SelfServeAccountDeleteEnabled = true
+				config.Console.DeleteProjectEnabled = true
+			},
+		},
+	}, func(t *testing.T, ctx *testcontext.Context, planet *testplanet.Planet) {
+		sat := planet.Satellites[0]
+		service := sat.API.Console.Service
+		users := sat.DB.Console().Users()
+
+		// guest accounts are created with a random password the user never sees.
+		createGuest := func(t *testing.T) *console.User {
+			guestEmail := strings.ReplaceAll(testrand.UUID().String(), "-", "") + "@example.net"
+			user, err := service.CreateUser(ctx, console.CreateUser{
+				Email:       guestEmail,
+				Password:    testrand.UUID().String(),
+				AllowNoName: true,
+			}, nil)
+			require.NoError(t, err)
+			require.Equal(t, console.Active, user.Status)
+			return user
+		}
+
+		userCtx := func(t *testing.T, userID uuid.UUID) context.Context {
+			userCtx, err := sat.UserContext(ctx, userID)
+			require.NoError(t, err)
+			return userCtx
+		}
+
+		getUser := func(t *testing.T, userID uuid.UUID) *console.User {
+			user, err := users.Get(ctx, userID)
+			require.NoError(t, err)
+			return user
+		}
+
+		t.Run("guest changes password without the old one", func(t *testing.T) {
+			guest := createGuest(t)
+
+			newPassword := "guest-chosen-password"
+			err := service.ChangePassword(userCtx(t, guest.ID), "", newPassword, nil)
+			require.NoError(t, err)
+
+			user := getUser(t, guest.ID)
+			require.NoError(t, bcrypt.CompareHashAndPassword(user.PasswordHash, []byte(newPassword)))
+
+			// the new password is still validated.
+			err = service.ChangePassword(userCtx(t, guest.ID), "", "short", nil)
+			require.Error(t, err)
+			require.True(t, console.ErrValidation.Has(err))
+		})
+
+		t.Run("non-guest still needs the old password", func(t *testing.T) {
+			user, err := sat.AddUser(ctx, console.CreateUser{
+				FullName: "Regular User",
+				Email:    "regular-change-password@mail.test",
+			}, 1)
+			require.NoError(t, err)
+
+			err = service.ChangePassword(userCtx(t, user.ID), "", "a-new-password", nil)
+			require.Error(t, err)
+			require.True(t, console.ErrChangePassword.Has(err))
+
+			err = service.ChangePassword(userCtx(t, user.ID), "wrong-password", "a-new-password", nil)
+			require.Error(t, err)
+			require.True(t, console.ErrChangePassword.Has(err))
+
+			// sat.AddUser uses the full name as the password.
+			err = service.ChangePassword(userCtx(t, user.ID), user.FullName, "a-new-password", nil)
+			require.NoError(t, err)
+		})
+
+		t.Run("guest that moved to a real email needs the old password", func(t *testing.T) {
+			guest := createGuest(t)
+
+			password := "guest-chosen-password"
+			require.NoError(t, service.ChangePassword(userCtx(t, guest.ID), "", password, nil))
+
+			realEmail := "former-guest@mail.test"
+			require.NoError(t, users.Update(ctx, guest.ID, console.UpdateUserRequest{Email: &realEmail}))
+
+			err := service.ChangePassword(userCtx(t, guest.ID), "", "another-password", nil)
+			require.Error(t, err)
+			require.True(t, console.ErrChangePassword.Has(err))
+
+			err = service.ChangePassword(userCtx(t, guest.ID), password, "another-password", nil)
+			require.NoError(t, err)
+
+			// the email change flow asks for the password again, too.
+			err = service.ChangeEmail(userCtx(t, guest.ID), console.VerifyAccountPasswordStep, "wrong-password")
+			require.Error(t, err)
+			require.Equal(t, 0, getUser(t, guest.ID).EmailChangeVerificationStep)
+		})
+
+		t.Run("guest deletes a project without password or email code", func(t *testing.T) {
+			guest := createGuest(t)
+
+			project, err := sat.AddProject(ctx, guest.ID, "guest project")
+			require.NoError(t, err)
+
+			_, err = service.DeleteProject(userCtx(t, guest.ID), project.ID, console.DeleteProjectInit, "")
+			require.NoError(t, err)
+
+			_, err = service.DeleteProject(userCtx(t, guest.ID), project.ID, console.VerifyAccountPasswordStep, "")
+			require.NoError(t, err)
+
+			user := getUser(t, guest.ID)
+			require.Equal(t, console.VerifyAccountEmailStep, user.EmailChangeVerificationStep)
+			require.Empty(t, user.ActivationCode)
+			require.Zero(t, user.FailedLoginCount)
+
+			_, err = service.DeleteProject(userCtx(t, guest.ID), project.ID, console.DeleteProjectStep, "")
+			require.NoError(t, err)
+
+			deleted, err := sat.DB.Console().Projects().Get(ctx, project.ID)
+			require.NoError(t, err)
+			require.NotNil(t, deleted.Status)
+			require.Equal(t, console.ProjectDisabled, *deleted.Status)
+		})
+
+		t.Run("guest deletes the account without password or email code", func(t *testing.T) {
+			guest := createGuest(t)
+
+			_, err := service.DeleteAccount(userCtx(t, guest.ID), console.DeleteAccountInit, "")
+			require.NoError(t, err)
+
+			_, err = service.DeleteAccount(userCtx(t, guest.ID), console.VerifyAccountPasswordStep, "")
+			require.NoError(t, err)
+
+			user := getUser(t, guest.ID)
+			require.Equal(t, console.VerifyAccountEmailStep, user.EmailChangeVerificationStep)
+			require.Empty(t, user.ActivationCode)
+
+			_, err = service.DeleteAccount(userCtx(t, guest.ID), console.DeleteAccountStep, "")
+			require.NoError(t, err)
+
+			require.Equal(t, console.Deleted, getUser(t, guest.ID).Status)
+		})
+
+		t.Run("direct password hash update keeps sessions", func(t *testing.T) {
+			// existing guests get a new password hash straight in the database (no
+			// ChangePassword call), and must stay logged in.
+			guest := createGuest(t)
+
+			tokenInfo, err := service.GenerateSessionToken(ctx, console.SessionTokenRequest{
+				UserID: guest.ID,
+				Email:  guest.Email,
+			})
+			require.NoError(t, err)
+
+			hash, err := bcrypt.GenerateFromPassword([]byte(testrand.UUID().String()), bcrypt.MinCost)
+			require.NoError(t, err)
+			require.NoError(t, users.Update(ctx, guest.ID, console.UpdateUserRequest{PasswordHash: hash}))
+
+			authCtx, _, err := service.TokenAuth(ctx, tokenInfo.Token, time.Now())
+			require.NoError(t, err)
+
+			authUser, err := console.GetUser(authCtx)
+			require.NoError(t, err)
+			require.Equal(t, guest.ID, authUser.ID)
+		})
+
+		t.Run("non-guest still needs the password to delete", func(t *testing.T) {
+			user, err := sat.AddUser(ctx, console.CreateUser{
+				FullName: "Regular Deleter",
+				Email:    "regular-delete@mail.test",
+			}, 1)
+			require.NoError(t, err)
+
+			_, err = service.DeleteAccount(userCtx(t, user.ID), console.VerifyAccountPasswordStep, "wrong-password")
+			require.Error(t, err)
+			require.True(t, console.ErrValidation.Has(err))
+			require.Equal(t, 0, getUser(t, user.ID).EmailChangeVerificationStep)
+
+			_, err = service.DeleteAccount(userCtx(t, user.ID), console.VerifyAccountPasswordStep, user.FullName)
+			require.NoError(t, err)
+
+			// a regular user still has to verify the email code next.
+			updated := getUser(t, user.ID)
+			require.Equal(t, console.VerifyAccountPasswordStep, updated.EmailChangeVerificationStep)
+			require.NotEmpty(t, updated.ActivationCode)
+		})
+	})
+}
