+export function generateGuestEmail(): string {
+    const domains = Array.from(GUEST_EMAIL_DOMAINS);
+    const domain = domains[Math.floor(Math.random() * domains.length)].toLowerCase();
+    const uuid = crypto.randomUUID().replace(/-/g, '');
+    return `${uuid}@${domain}`;
