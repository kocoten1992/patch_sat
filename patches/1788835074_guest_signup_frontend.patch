+    /**
+     * Used to register a guest account. Guest accounts are activated on creation and
+     * the satellite starts the session (sets the auth cookie) in the same response,
+     * so no separate login request is needed.
+     *
+     * @param email - generated guest email
+     * @param password - guest password
+     * @param secret - registration token
+     * @param captchaResponse - captcha response token
+     * @returns token info of the started session, or null if the satellite did not start one
+     * @throws Error
+     */
+    public async registerGuest(email: string, password: string, secret: string, captchaResponse: string): Promise<TokenInfo | null> {
+        const path = `${this.ROOT_PATH}/register`;
+        const body = {
+            secret,
+            email,
+            password,
+            captchaResponse,
+            isMinimal: true,
+        };
+
+        const response = await this.http.post(path, JSON.stringify(body));
+        if (response.ok) {
+            const text = await response.text();
+            if (!text) return null;
+
+            const result = JSON.parse(text);
+            if (!result.token) return null;
+
+            return new TokenInfo(result.token, new Date(result.expiresAt));
+        }
+
+        const result = await response.json();
+        throw new APIError({
+            status: response.status,
+            message: result.error || 'Cannot register guest user',
+            requestID: response.headers.get('x-request-id'),
+        });
+    }
