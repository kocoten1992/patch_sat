+        captcha.execute();
+        return;
+    }
+
+    await guestSignup();
+}
+
+async function guestSignup(): Promise<void> {
+    guestEmail.value = generateGuestEmail();
+    try {
+        await auth.register({
+            email: guestEmail.value,
+            password: guestEmail.value,
+            isMinimal: true,
+        }, secret.value, captchaResponseToken.value);
+    } catch (error) {
+        notify.notifyError(error);
+        isGuestLoading.value = false;
+        return;
+    } finally {
+        getCaptcha()?.reset();
+        captchaResponseToken.value = '';
+    }
+
+    await router.push({ name: ROUTES.Login.name, query: { email: guestEmail.value } });
+    isGuestLoading.value = false;
+}
