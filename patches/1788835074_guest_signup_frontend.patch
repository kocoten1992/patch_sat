+async function onGuestLoginClick(): Promise<void> {
+    if (isGuestLoading.value || isLoading.value) return;
+
+    isGuestLoading.value = true;
+
+    const captcha = getCaptcha();
+    if (captcha && !captchaResponseToken.value && !secret.value) {
+        // onCaptchaVerified() will pick this up and call guestSignup()
