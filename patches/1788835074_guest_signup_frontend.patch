+/**
+ * Holds on 'Login as Guest' button click logic.
+ */
+async function onGuestLoginClick(): Promise<void> {
+    if (isGuestLoading.value || isLoading.value) return;
+
+    isGuestLoading.value = true;
+
+    const captcha = getCaptcha();
+    if (captcha && !captchaResponseToken.value && !secret.value) {
+        // onCaptchaVerified() will pick this up and call guestSignup()
+        // once the widget resolves.
+        captcha.execute();
+        return;
+    }
+
+    await guestSignup();
+}
+
+/**
+ * Creates a guest account and starts its session right away (no login step).
+ */
+async function guestSignup(): Promise<void> {
+    const guestEmail = generateGuestEmail();
+
+    let tokenInfo: TokenInfo | null;
+    try {
+        // The guest account is activated on creation and the satellite sets
+        // the session cookie in the same response.
+        tokenInfo = await auth.registerGuest(guestEmail, guestEmail, secret.value, captchaResponseToken.value);
+    } catch (error) {
+        notify.notifyError(error);
+        isGuestLoading.value = false;
+        return;
+    } finally {
+        getCaptcha()?.reset();
+        captchaResponseToken.value = '';
+    }
+
+    if (!tokenInfo) {
+        notify.error('Could not start a guest session. Please try again.', null);
+        isGuestLoading.value = false;
+        return;
+    }
+
+    LocalData.setSessionExpirationDate(tokenInfo.expiresAt);
+    LocalData.removeSessionHasExpired();
+    appStore.toggleHasJustLoggedIn(true);
+    usersStore.login();
+
+    await router.push(ROUTES.Projects.path);
+    isGuestLoading.value = false;
+}
